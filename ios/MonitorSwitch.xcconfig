// Shared build settings. Put your own team and bundle id prefix in
// Local.xcconfig (gitignored), see Local.xcconfig.example.
SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0

PRODUCT_NAME = MonitorSwitch
BUNDLE_ID_PREFIX = com.example
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).monitor-switch
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Monitor Switch
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UIUserInterfaceStyle = Dark
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ALWAYS_SEARCH_USER_PATHS = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_PREVIEWS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

#include? "Local.xcconfig"
